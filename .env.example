# Copy to .env.local. Every variable is optional: with none set, the store runs on demo data.

# Public URL of the storefront, used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WooGraphQL endpoint. Leave empty to use the built-in demo catalog.
# With the Docker backend in ./wordpress: http://localhost:8080/graphql
WORDPRESS_GRAPHQL_URL=

# Currency of WooCommerce prices and how often (seconds) static pages refresh.
STORE_CURRENCY=LKR
CATALOG_REVALIDATE_SECONDS=300

# Shared secret for POST /api/revalidate (sent by WooCommerce webhooks).
# Generate one with: openssl rand -hex 32
REVALIDATE_SECRET=

# Bakery WhatsApp number in international format without "+", for example 94771234567.
# Empty lets the customer choose a contact in WhatsApp.
ORDER_WHATSAPP_NUMBER=
